<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />

    <%!-- Primary Meta Tags --%>
    <.live_title suffix=" | YoganHockey">
      {assigns[:page_title] || "Live NHL Stats & Player Tracking"}
    </.live_title>
    <meta name="title" content={meta_title(assigns)} />
    <meta name="description" content={assigns[:meta_description] || "Real-time NHL scores, standings, and stats. Follow Andrew Yogan's career from the AHL to DEL. Live game updates, team schedules, and comprehensive hockey statistics."} />
    <meta name="keywords" content="NHL, hockey, stats, live scores, Andrew Yogan, DEL, standings, teams, player stats" />
    <meta name="author" content="YoganHockey" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="English" />
    <link rel="canonical" href={assigns[:og_url] || "https://yoganhockey.com/"} />

    <%!-- Theme & App --%>
    <meta name="theme-color" content="#0f172a" />
    <meta name="color-scheme" content="dark light" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="YoganHockey" />

    <%!-- Open Graph / Facebook / iMessage --%>
    <meta property="og:type" content={assigns[:og_type] || "website"} />
    <meta property="og:url" content={assigns[:og_url] || "https://yoganhockey.com/"} />
    <meta property="og:title" content={assigns[:og_title] || "YoganHockey | Live NHL Stats & Player Tracking"} />
    <meta property="og:description" content={assigns[:og_description] || "Real-time NHL scores, standings, and stats. Follow Andrew Yogan's career. Live game updates and comprehensive hockey statistics."} />
    <meta property="og:image" content={assigns[:og_image] || "https://yoganhockey.com/images/og/default.svg"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={assigns[:og_title] || "YoganHockey - Live NHL Stats"} />
    <meta property="og:site_name" content="YoganHockey" />
    <meta property="og:locale" content="en_US" />

    <%!-- Twitter / X --%>
    <meta name="twitter:card" content={assigns[:twitter_card] || "summary_large_image"} />
    <meta name="twitter:url" content={assigns[:og_url] || "https://yoganhockey.com/"} />
    <meta name="twitter:title" content={assigns[:og_title] || "YoganHockey | Live NHL Stats"} />
    <meta name="twitter:description" content={assigns[:og_description] || "Real-time NHL scores, standings, and stats. Follow Andrew Yogan's career from AHL to DEL."} />
    <meta name="twitter:image" content={assigns[:og_image] || "https://yoganhockey.com/images/og/default.svg"} />
    <meta name="twitter:image:alt" content={assigns[:og_title] || "YoganHockey - Live NHL Stats"} />

    <%!-- Favicon --%>
    <link rel="icon" type="image/svg+xml" href={~p"/images/logo.svg"} />
    <link rel="icon" type="image/x-icon" href={~p"/favicon.ico"} />
    <link rel="apple-touch-icon" sizes="180x180" href={~p"/images/logo.svg"} />
    <link rel="manifest" href="/site.webmanifest" />

    <%!-- JetBrains Mono font for stats display --%>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
            document.documentElement.setAttribute("data-theme", prefersDark ? "dark" : "light");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };

        // Set initial theme
        const savedTheme = localStorage.getItem("phx:theme");
        if (savedTheme) {
          setTheme(savedTheme);
        } else {
          setTheme("system");
        }

        // Listen for storage changes (other tabs)
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));

        // Listen for theme toggle events
        window.addEventListener("phx:set-theme", (e) => setTheme(e.detail.theme || e.target.dataset.phxTheme));

        // Listen for system preference changes
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
          if (!localStorage.getItem("phx:theme")) {
            setTheme("system");
          }
        });
      })();
    </script>
  </head>
  <body class="min-h-full bg-base-100 text-base-content font-sans antialiased">
    {@inner_content}
  </body>
</html>
